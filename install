#!/bin/bash

set -e

link_files() {
    echo "Linking config files"

    if [ ! -d "$HOME/.config" ]; then
        mkdir $HOME/.config
    fi

    # User config directories linking
    for dir in $(find user/* -type d); do
        d=$(basename $dir)
        if [ -L ${HOME}/.config/${d} ]; then
            echo "$d already linked. Skipping."
        else
            echo "Linking $d"
            ln -sf $(pwd)/$dir $HOME/.config/$d
        fi
    done

    # User config files linking
    for file in $(find user/ -maxdepth 1 -type f); do
        filename=$(basename $file)

        if [ -L ${HOME}/${filename} ]; then
            echo "$filename already linked. Skipping."
        else
            echo "Linking $filename"
            ln -sf $(pwd)/$file $HOME/$filename
        fi
    done

    if ! [ -L /etc/scripts  ]; then
        echo "Linking config for ZRAM service (may require sudo password)"
        /usr/bin/sudo ln -sf $(pwd)/etc/scripts /etc/scripts
    else
        echo "/etc/scripts is already linked. Skipping"
    fi

    if ! [ -L /etc/systemd/system/zram.service ]; then
        echo "Linking systemd service for ZRAM (may require sudo password)"
        /usr/bin/sudo ln -sf $(pwd)/etc/systemd/system/zram.service /etc/systemd/system/zram.service
    else
        echo "systemd service already linked. Skipping"
    fi

    echo ""
    echo "Enabling ZRAM service"

    /usr/bin/sudo systemctl enable --now zram.service
}

install_tmux() {
    if ! [ -d  ]
}

install_yay() {
    if ! command -v yay >/dev/null 2>&1; then
        echo "yay command not found. Installing yay"

        folder=$(mktemp -d)
        /usr/bin/git clone https://aur.archlinux.org/yay $folder
        pushd $folder
        makepkg -si
        popd
        rm -rf $folder
    fi
}

install_packages() {
    echo "Installing packages"
    packages=""

    while read -r line; do
        packages="$packages $line"
    done < ".packagelist"

    /usr/bin/yay -Sy --needed $packages
}

install_st() {
    echo "Compiling and installing st (simple terminal)"
    folder=$(mktemp -d)
    /usr/bin/git clone https://github.com/CommandMaker/st $folder
    pushd $folder
    /usr/bin/sudo make install
    popd
    rm -rf $folder
}

main() {
    link_files
    # install_yay
    install_packages
    # install_st
}


main
